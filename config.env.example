# Kopieren nach config.env und anpassen (install-Skripte machen das automatisch)

# Kameras – leer lassen = Standard (Windows: 0,1,2 · Linux: /dev/video0,/dev/video2,/dev/video4)
# Verfügbare anzeigen:  python run.py --list-cameras
# Linux-Tipp: stabile Pfade aus /dev/v4l/by-path/ verwenden (ändern sich nach Neustart nicht)
#CAMERAS=0,1,2
#CAMERAS=/dev/video0,/dev/video2,/dev/video4

# Auflösung: auto = beim ersten Start die höchste testen, die alle Kameras flüssig schaffen (neu: run.py --probe-res)
CAM_W=auto
CAM_H=auto
# Windows: 3 Kameras brauchen MJPG. Läuft nur YUY2 (--test-cameras) → CAM_BACKEND=msmf probieren oder CAM_W=848 / CAM_H=480
#CAM_BACKEND=dshow
# Belichtung fest (gegen Helligkeitssprünge). Windows z. B. -6 (kleiner = dunkler), Linux z. B. 150
#CAM_EXPOSURE=-6
PORT=8090
HOST=0.0.0.0

# Erkennung-Tuning
DIFF_THR=28
DART_MIN=250
DART_MAX=40000
# Takeout: Restabweichung zum leeren Board (Pixel). Leer = 3 × DART_MIN
#TAKEOUT_PX=750
STABLE_FRAMES=6
FUSE_MM=12

# Zugangsschutz (z. B. wenn die App aus dem Internet erreichbar ist): einmal /?key=… öffnen
# ACCESS_KEY=

# Abgleich mit dem Trainings-Rechner (Nextcloud) – siehe docs/TRAINING.md
# Empfohlen: zwei Freigabelinks statt Konto (Board kann nur hochladen bzw. Modell lesen)
#SYNC_UPLOAD_LINK=https://cloud.example.de/s/AbCdEf     # Ordner train, Freigabe „Dateiablage“
#SYNC_UPLOAD_PASS=
#SYNC_MODEL_LINK=https://cloud.example.de/s/GhIjKl      # Ordner models, nur lesen
#SYNC_MODEL_PASS=
#SYNC_AUTO_UPLOAD=1
#SYNC_PART_MB=4            # Paketgröße beim Hochladen (kleiner = robuster bei zickigen Proxys)
# Alternativ Konto-Zugang:
#SYNC_URL=https://cloud.example.de/remote.php/dav/files/BENUTZER/BullsnBier-Sync
#SYNC_USER=BENUTZER
#SYNC_PASS=App-Passwort
#SETUP_NAME=Buschi
#SYNC_AUTO_MODEL=0

# --- Trainingsmodus mit Autodarts (einmalig: bash tools/autodarts-setup.sh) ---
#AD_URL=http://localhost:3180
#AD_PROXY_DEVS=/dev/video10,/dev/video11,/dev/video12
#AD_PROXY_FPS=30
#AD_MANAGE=1               # Autodarts-Dienst mit dem Modus starten/stoppen
#AD_AGREE_MM=4             # so nah müssen beide Treffer liegen, damit sie als einig gelten
#AD_TRUST_SOLO=0           # 1 = „nur Autodarts“-Würfe ohne Prüfen als markiert übernehmen
